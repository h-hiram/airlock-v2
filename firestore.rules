rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /disclosures/{disclosureId} {
      // Anyone can inspect the selective disclosure attestation
      // If revoked, the payload is permanently wiped (tombstoned)
      allow read: if true;

      // Authenticated users (including anonymous auth) can create selective disclosure attestations
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.revoked == false;

      // Owner can revoke (tombstone) or public viewers can increment viewCount
      allow update: if (
        // Case 1: Owner revoking / tombstoning
        (request.auth != null && request.auth.uid == resource.data.ownerUid)
        // Case 2: Atomic view count increment on active unrevoked disclosure
        || (resource.data.revoked == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']))
      );

      // Only owner can permanently delete attestation
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
  }
}
