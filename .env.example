# Firebase Configuration (Required for Live Cloud AI & Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (Production ReCaptcha Key)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Local Development App Check Debug Token (Keep secret, do not commit .env.local)
VITE_APPCHECK_DEBUG_TOKEN=true

